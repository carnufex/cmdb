root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[tests/**.cs]
# Test names read as sentences.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[src/database/Migrations/**.cs]
# Generated by dotnet ef; never edited by hand.
generated_code = true
dotnet_analyzer_diagnostic.severity = none
