{
  "key": "acme-ar-10",
  "manufacturer": "Acme Networks",
  "model": "AR-10",
  "category": "router",
  "rackUnits": 1,
  "panel": { "rows": 2, "columns": 6 },
  "ports": [
    {
      "name": "ge-0/0/{n}",
      "range": [1, 8],
      "type": "RJ45",
      "group": "lan",
      "at": [0, 0],
      "layout": "zigzag"
    },
    {
      "name": "xe-0/1/{n}",
      "range": [1, 2],
      "type": "SFP+",
      "group": "wan",
      "at": [0, 4],
      "layout": "column"
    },
    {
      "name": "mgmt",
      "type": "RJ45",
      "group": "management",
      "at": [0, 5]
    },
    {
      "name": "console",
      "type": "RJ45",
      "group": "management",
      "at": [1, 5]
    }
  ],
  "attributes": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "serialNumber": {
        "type": "string"
      },
      "firmware": {
        "type": "string"
      },
      "loopbackIp": {
        "type": "string",
        "format": "ipv4"
      },
      "asNumber": {
        "type": "integer",
        "minimum": 64512,
        "maximum": 65534
      }
    },
    "additionalProperties": false
  }
}
