# Rendered by the nginx image's envsubst step at start. API_UPSTREAM defaults to the compose service.

# Behind the cluster gateway TLS ends before nginx, so keep the scheme the gateway saw (https in the demo);
# locally there is no such header and nginx's own scheme is right.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 8080;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # MCP for agents (ADR-0011). Responses may stream, so nothing is buffered.
  location = /mcp {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # The operations agent's voice channel (ADR-0015): the voice platform's MCP client, with its own secret.
  location = /voice/mcp {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # OAuth Protected Resource Metadata (RFC 9728): MCP clients discover the identity provider here.
  location ^~ /.well-known/oauth-protected-resource {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Runtime settings for the SPA; overrides public/config.json (which is for ng serve).
  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"oidcAuthority":"${OIDC_AUTHORITY}","oidcClientId":"${OIDC_CLIENT_ID}","basemap":"${MAP_BASEMAP}","voiceAgentId":"${VOICE_AGENT_ID}"}';
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
