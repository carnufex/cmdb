# Rendered by the nginx image's envsubst step at start. API_UPSTREAM defaults to the compose service.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # MCP for agents (ADR-0011). Responses may stream, so nothing is buffered.
  location = /mcp {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Runtime settings for the SPA; overrides public/config.json (which is for ng serve).
  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"oidcAuthority":"${OIDC_AUTHORITY}","oidcClientId":"${OIDC_CLIENT_ID}","basemap":"${MAP_BASEMAP}"}';
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
